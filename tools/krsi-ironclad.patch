+// SCAP access mode encoding is RDONLY=1, WRONLY=2, RDWR=3. O_TRUNC and
+// creation can mutate policy even without a write-capable descriptor.
+fn ironclad_write_open(flags: u32) -> u64 {
+    use krsi_common::scap::{PPM_O_WRONLY, PPM_O_CREAT, PPM_O_TRUNC, PPM_O_F_CREATED};
+    u64::from(flags & (PPM_O_WRONLY | PPM_O_CREAT | PPM_O_TRUNC | PPM_O_F_CREATED) != 0)
+}
